{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StarNet",
  "version": "0.1.0",
  "identifier": "ai.skynet.harness",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
