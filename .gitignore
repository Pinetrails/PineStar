# dependencies
node_modules/

# OS junk
Thumbs.db
Desktop.ini
.DS_Store

# logs / tmp
*.log
.tmp/

# machine-local Claude settings
.claude/settings.local.json

# agent runtime workspaces / notes (created by tools at run time)
workspaces/
sidecar/workspaces/
sidecar/workspaces.*/
# preview/verify sidecar workspaces (per-worktree launch.json SKYNET_WORKSPACES)
.verify-workspaces/
.dev-workspaces*/

# dev seed launcher: local secrets + the throwaway seeded workspace it materializes
dev/.env.dev
dev/.scratch-workspace/
# mock-cron dev sidecar runtime state (roster/goals/cron json + .bak churn; never committed)
dev/.scratch-mock-cron/

# rust / tauri desktop shell build output
src-tauri/target/
src-tauri/gen/

# cut release artifacts (installer + sig + updater manifest; distributed via GitHub Releases, never committed)
release/

# bundled Node runtime fetched by scripts/prepare-node.mjs (large build input, never committed)
src-tauri/binaries/

# visual-harness screenshot output — regenerated scratch from uishoot/uiplay/uiresidue/uisummon
# (each run writes a SHOT_DIR with a nested _profile chrome user-data-dir). Never committed.
.uishots*/
.mock-shot/
.qa_tmp/
.tmpshot/
.postcard-verify/
.clip-verify/
.uiplay/
.uiresidue/
.uisummon/
.uiaudit/
.uijourneys/
.uiatlas/
.uigolden/
.dogfood/
.bugloops/
.matest-workspaces/
# skin-generation working files (pixellab scratch; the committed sprite sets + _preset recipe stay tracked)
frontend/assets/sprites/_clawd_work/
# manual backup copy of the minion sprite preset (live set is tracked at frontend/assets/sprites/minion/)
design/minion_backup_preset/
# scripts/devverify.mjs --smoke chrome profile dirs (self-cleaned after each run; this is belt-and-suspenders)
.devverify-chrome-*/
# scripts/board.mjs --write output (a regenerated snapshot; the live board is `node scripts/board.mjs`)
scripts/STATUS.generated.md

# QA ledger findings — one <id>.json per finding, written at RUN TIME by scripts/qa/ledger.mjs
# (and janitor.mjs) into whatever checkout the crew runs in. They are MACHINE-LOCAL run
# artifacts: their evidence[] paths point at gitignored .bugloops/ output with absolute local
# paths baked in, and dismissed/known triage state is ephemeral (the durable, portable baseline
# lives in qa/KNOWN_ISSUES.md; re-blessed visual goldens live in scripts/goldens.json — both
# tracked). The scripts read/create qa/findings/ physically via fs, never from git, so ignoring
# these does not affect them. Keep the dir itself (via .gitkeep) + the README (a .md, not matched).
qa/findings/*.json

# QA READY-GATE machine stamps (EL-7) — last-run state each crew runner writes at RUN TIME for
# scripts/qa/ready.mjs to read. Same class as qa/findings: machine-local, ephemeral, regenerated
# every cycle (carry local trunk shas + timestamps), read via fs never from git.
qa/guardian-last-cycle.json
qa/journeys-last-run.json
qa/beginner-last-run.json

# Installed-exe smoke run artifacts (scripts/qa/installed-smoke.mjs). The pinned stamp
# (last-smoke.json) + per-run evidence dirs are MACHINE-LOCAL: the stamp records THIS machine's
# installed build + the local trunk head it ran against, and the qa:ready gate reads it via fs at
# run time (never from git). Same reasoning as qa/findings above — keep the dir (.gitkeep + README),
# ignore the run output. (Granular entries, NOT a dir-level ignore: .gitkeep + README are tracked.)
qa/installed/last-smoke.json
qa/installed/smoke-*/

# G0 lane visual-proof screenshots (headless capture output; never committed)
.qa_g0/
# G1a lane visual-proof screenshots (same pattern)
.qa_g1a/
# G2 lane visual-proof screenshots (same pattern)
.qa_g2/
# G3a lane visual-proof screenshots (same pattern)
.qa_g3a/
# G1b lane visual-proof screenshots (same pattern)
.qa_g1b/
# G1c lane visual-proof screenshots (same pattern)
.qa_g1c/
# bootfix lane visual-proof + repro scratch (headless shoot captures + the tarpit repros; never committed)
.qa_bootfix/
.qa_bootfix_full/
# G3b lane visual-proof screenshots (TROPHY CASE + seed-reuse callout; same pattern)
.qa_g3b/
# G4 lane visual-proof screenshots (approval walk-and-wait + autojob pin + Meeseeks; same pattern)
.qa_g4/
